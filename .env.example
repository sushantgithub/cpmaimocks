# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cpmai_db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars-long"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email (Nodemailer / SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@your-domain.com"
EMAIL_FROM_NAME="CertMocks"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CertMocks"
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Admin
ADMIN_EMAIL="admin@your-domain.com"

# Optional: Resend (alternative email provider)
RESEND_API_KEY=""
