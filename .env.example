# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cpmai_db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars-long"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email (Nodemailer / SMTP via Resend)
# SMTP_USER is literally "resend"; SMTP_PASS is a Resend API key (re_...).
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="resend"
SMTP_PASS=""
EMAIL_FROM="noreply@certmocks.com"
EMAIL_FROM_NAME="CertMocks"
# Where replies to noreply mail should land (a Cloudflare Email Routing address)
EMAIL_REPLY_TO="support@certmocks.com"
# Where the contact form is delivered (defaults to EMAIL_REPLY_TO)
CONTACT_EMAIL=""

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CertMocks"

# Vercel sends this as a bearer token when it calls /api/cron/daily
CRON_SECRET=""

# Admin
ADMIN_EMAIL="admin@your-domain.com"

# Optional: Resend (alternative email provider)
RESEND_API_KEY=""
