generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
  TRIAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionContentType {
  QUIZ
  MOCK_EXAM
  PRACTICE_ONLY
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     DateTime?
  name              String?
  image             String?
  passwordHash      String?
  role              Role      @default(USER)
  isActive          Boolean   @default(true)
  deletionRequested Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  subscriptions      Subscription[]
  payments           Payment[]
  examAttempts       ExamAttempt[]
  bookmarks          Bookmark[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  couponRedemptions  CouponRedemption[]
  quizResets         QuizReset[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  price        Float
  currency     String   @default("INR")
  durationDays Int
  features     Json     @default("[]")
  isActive     Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  trialDays    Int      @default(0)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // null means the plan grants access to every certification
  certificationId String?

  certification Certification? @relation(fields: [certificationId], references: [id])
  subscriptions Subscription[]
  payments      Payment[]
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  planId             String
  status             SubscriptionStatus @default(PENDING)
  startDate          DateTime?
  endDate            DateTime?
  trialEndsAt        DateTime?
  autoRenew          Boolean            @default(false)
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId, status])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  subscriptionId    String?
  planId            String?
  amount            Float
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  provider          String        @default("razorpay")
  providerPaymentId String?
  providerOrderId   String?
  providerSignature String?
  couponId          String?
  discountAmount    Float         @default(0)
  metadata          Json?
  failureReason     String?
  refundedAt        DateTime?
  refundAmount      Float?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user         User              @relation(fields: [userId], references: [id])
  subscription Subscription?     @relation(fields: [subscriptionId], references: [id])
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id])
  coupon       Coupon?           @relation(fields: [couponId], references: [id])

  @@index([userId, status])
  @@index([providerPaymentId])
  @@index([providerOrderId])
}

/// A quiz that groups questions by tag rather than by domain, e.g. an
/// algorithm drill whose questions live in several domains. Domain quizzes
/// need no row here: they are derived from the certification's categories.
model Quiz {
  id              String   @id @default(cuid())
  title           String
  slug            String
  description     String?
  certificationId String
  categoryId      String
  tag             String
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([slug, certificationId])
  @@index([categoryId, sortOrder])
}

/// Marks when someone restarted a mastered quiz. Answers given before this
/// point stop counting as seen, so the quiz serves its questions afresh.
model QuizReset {
  id      String   @id @default(cuid())
  userId  String
  quizKey String
  resetAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, quizKey])
}

model Certification {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  fullName    String?
  description String?
  isActive    Boolean  @default(true)
  /// Certifications such as PMP/PMI-ACP/CPMAI use domains. Others can place
  /// questions directly under the certification without domain validation.
  usesDomains Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories Category[]
  questions  Question[]
  exams      MockExam[]
  plans      SubscriptionPlan[]
  quizzes    Quiz[]
  importBatches QuestionImportBatch[]
}

model Category {
  id              String   @id @default(cuid())
  name            String
  slug            String
  certificationId String
  description     String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  questions     Question[]
  topics        Topic[]
  quizzes       Quiz[]

  @@unique([name, certificationId])
  @@unique([slug, certificationId])
}

model Topic {
  id          String   @id @default(cuid())
  name        String
  slug        String
  categoryId  String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  category  Category   @relation(fields: [categoryId], references: [id])
  questions Question[]

  @@unique([slug, categoryId])
}

model Question {
  id              String         @id @default(cuid())
  questionId      String         @unique
  text            String         @db.Text
  optionA         String         @db.Text
  optionB         String         @db.Text
  optionC         String         @db.Text
  optionD         String         @db.Text
  /// Present only on multiple-response questions, which PMI writes with up to
  /// six options; four remains the norm.
  optionE         String?        @db.Text
  optionF         String?        @db.Text
  /// One letter, or several comma separated in alphabetical order ("A,C") for
  /// a multiple-response question. Marked all-or-nothing, as PMI marks them.
  correctAnswer   String
  /// The key idea: one line naming the principle the question tests. Shown
  /// above the per-option explanations, and the only explanation older
  /// questions carry.
  explanation     String         @db.Text
  /// Why each option is right or wrong, one per option. Written so a learner
  /// who picked B is told why B fails without reading all four.
  explanationA    String?        @db.Text
  explanationB    String?        @db.Text
  explanationC    String?        @db.Text
  explanationD    String?        @db.Text
  explanationE    String?        @db.Text
  explanationF    String?        @db.Text
  certificationId String
  categoryId      String?
  topicId         String?
  difficulty      Difficulty          @default(MEDIUM)
  status          QuestionStatus      @default(DRAFT)
  /// Controls where the question is surfaced. Content pools are exclusive:
  /// QUIZ -> Quiz only, MOCK_EXAM -> Mock only, PRACTICE_ONLY -> Practice only.
  contentType     QuestionContentType @default(QUIZ)
  /// Marks throwaway content imported to try the platform out, so it can be
  /// found and removed later without guessing from names or domains.
  isTest          Boolean        @default(false)
  source          String?
  tags            String[]       @default([])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  certification     Certification      @relation(fields: [certificationId], references: [id])
  category          Category?          @relation(fields: [categoryId], references: [id])
  topic             Topic?             @relation(fields: [topicId], references: [id])
  mockExamQuestions MockExamQuestion[]
  examAnswers       ExamAnswer[]
  bookmarks         Bookmark[]
  importBatchId     String?
  importBatch       QuestionImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([importBatchId])
  @@index([categoryId, difficulty, status])
  @@index([status])
  @@index([certificationId, status])
  @@index([certificationId, contentType, status])
  @@index([isTest])
}

model MockExam {
  id                  String     @id @default(cuid())
  title               String
  slug                String     @unique
  certificationId     String
  description         String?
  /// How many questions are linked to this exam: the pool it draws from.
  questionCount       Int
  /// How many of that pool a single attempt serves. Null serves all of them,
  /// which is what a full-length mock does; a domain mock sets it to 10.
  questionsPerAttempt Int?
  /// Zero means untimed, which is how domain mocks run.
  timeLimitMinutes    Int
  passingScore        Int        @default(70)
  status              ExamStatus @default(DRAFT)
  randomizeQuestions  Boolean    @default(true)
  showExplanations    Boolean    @default(true)
  requireSubscription Boolean    @default(true)
  sortOrder           Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  certification Certification      @relation(fields: [certificationId], references: [id])
  questions     MockExamQuestion[]
  attempts      ExamAttempt[]

  @@index([certificationId, status])
}

model QuestionImportBatch {
  id              String              @id @default(cuid())
  name            String
  certificationId String
  contentType     QuestionContentType
  sourceFilename  String?
  createdAt       DateTime            @default(now())

  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  questions     Question[]

  @@index([certificationId, contentType, createdAt])
}

model MockExamQuestion {
  id         String @id @default(cuid())
  examId     String
  questionId String
  sortOrder  Int    @default(0)

  exam     MockExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([examId, questionId])
}

model ExamAttempt {
  id               String        @id @default(cuid())
  userId           String
  examId           String?
  mode             String        @default("EXAM")
  status           AttemptStatus @default(IN_PROGRESS)
  startedAt        DateTime      @default(now())
  submittedAt      DateTime?
  timeTakenSeconds Int?
  score            Float?
  correctCount     Int?
  incorrectCount   Int?
  unansweredCount  Int?
  totalQuestions   Int
  practiceConfig   Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user    User         @relation(fields: [userId], references: [id])
  exam    MockExam?    @relation(fields: [examId], references: [id])
  answers ExamAnswer[]

  @@index([userId, status])
  @@index([userId, examId])
}

model ExamAnswer {
  id               String   @id @default(cuid())
  attemptId        String
  questionId       String
  selectedAnswer   String?
  isCorrect        Boolean?
  isMarked         Boolean  @default(false)
  timeTakenSeconds Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  note       String?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
}

model Coupon {
  id                 String    @id @default(cuid())
  code               String    @unique
  description        String?
  discountType       String
  discountValue      Float
  currency           String    @default("INR")
  minPurchase        Float?
  maxRedemptions     Int?
  currentRedemptions Int       @default(0)
  expiresAt          DateTime?
  isActive           Boolean   @default(true)
  applicablePlans    String[]  @default([])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  redemptions CouponRedemption[]
  payments    Payment[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  paymentId String?
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
}

model BlogPost {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String?
  content        String    @db.Text
  coverImage     String?
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  author         String?
  tags           String[]  @default([])
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  userId    String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId])
}
