# CertMocks staging environment
# Copy these values into Vercel Preview variables scoped ONLY to the staging branch.

APP_ENV="staging"
NEXT_PUBLIC_APP_ENV="staging"

# Separate Supabase project. Never use production credentials here.
# This project ref must occur in BOTH DATABASE_URL and DIRECT_URL.
STAGING_DATABASE_PROJECT_REF="your-staging-supabase-project-ref"
DATABASE_URL="postgresql://postgres.your-staging-supabase-project-ref:password@pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres:password@db.your-staging-supabase-project-ref.supabase.co:5432/postgres"

# Stable staging URL (replace after Vercel branch domain is configured)
NEXT_PUBLIC_APP_URL="https://staging.certmocks.com"
NEXTAUTH_URL="https://staging.certmocks.com"
NEXTAUTH_SECRET="use-a-separate-staging-secret"

# Google OAuth: use a staging callback/client or add the staging callback URL.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Razorpay MUST be test mode in staging.
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email: use staging/test credentials or a restricted sender.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="resend"
SMTP_PASS=""
EMAIL_FROM="staging@certmocks.com"
EMAIL_FROM_NAME="CertMocks Staging"
EMAIL_REPLY_TO=""
CONTACT_EMAIL=""

# Staging admin/test account
ADMIN_EMAIL="staging-admin@certmocks.com"
ADMIN_PASSWORD="set-a-strong-staging-only-password"

CRON_SECRET="use-a-separate-staging-secret"
NEXT_PUBLIC_APP_NAME="CertMocks Staging"
