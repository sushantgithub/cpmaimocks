# Minimal CertMocks staging environment
# Scope these values to: Preview -> Git branch "staging" ONLY.
#
# Existing Production/Preview variables may remain in Vercel. The application
# deliberately ignores inherited production OAuth/email/payment credentials
# while running on the staging branch.

STAGING_DATABASE_PROJECT_REF="rnybqrcdoxipdochiopo"

# Separate certmocks-staging Supabase project.
# DATABASE_URL: Transaction Pooler (6543)
# DIRECT_URL: Session Pooler (5432)
DATABASE_URL=""
DIRECT_URL=""

# Never reuse the production NextAuth secret.
STAGING_NEXTAUTH_SECRET="generate-a-new-random-secret-at-least-32-characters"

# Optional later, once explicit staging integrations are configured:
# STAGING_EMAIL_ALLOW_SEND="true"
# STAGING_OAUTH_ALLOW_GOOGLE="true"
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""
