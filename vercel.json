{
  "installCommand": "npm install --force",
  "ignoreCommand": "if git log -1 --pretty=%B | grep -Eq '\\[(deploy|staging)\\]'; then exit 1; else exit 0; fi",
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "30 3 * * *"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "staging": true,
      "claude/cpmai-exam-platform-dg2pob": true
    }
  }
}
